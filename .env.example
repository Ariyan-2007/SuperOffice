# Vastora Office — one codebase, two deployments.
#
# VITE_APP_MODE decides which app this build/deployment is:
#   backoffice  → the day-to-day console for ONE Business (catalog, orders, staff, deliveries)
#   superoffice → the cross-business control panel for a Tenant owner running several Businesses
#
# If VITE_APP_MODE is omitted, it's inferred: a VITE_BUSINESS_SLUG present means "backoffice",
# otherwise "superoffice" (see src/config/env.ts). Setting it explicitly is recommended for
# production deployments so the intent is never ambiguous.

VITE_API_BASE_URL=http://localhost:5276

# --- BackOffice only ---
# The public slug of the ONE Business this deployment belongs to. Every Business gets its own
# BackOffice deployment; this is the single value that makes a build "belong" to a client.
# Leave unset for a SuperOffice deployment.
VITE_APP_MODE=superoffice
VITE_BUSINESS_SLUG=vastora

# --- SuperOffice ---
# No extra config needed — login determines the Tenant. Example:
# VITE_APP_MODE=superoffice
